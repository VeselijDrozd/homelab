# Copy to kube-prometheus-stack-secrets.yml (gitignored) and set a real password:
#   cp kube-prometheus-stack-secrets.yml.example kube-prometheus-stack-secrets.yml
#
# Install / upgrade:
#   helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
#     -n monitoring --create-namespace \
#     -f kube-prometheus-stack-values.yml \
#     -f kube-prometheus-stack-secrets.yml

grafana:
  adminPassword: "CHANGE_ME_GRAFANA_ADMIN_PASSWORD"
