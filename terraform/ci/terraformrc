# Used in GitLab CI (and optionally locally) when registry.terraform.io
# is geo-blocked.
#
# This is a *provider network mirror*, NOT a full Terraform registry.
# Opening https://terraform-mirror.yandexcloud.net/ or
# .../.well-known/terraform.json in a browser/curl often returns 404 — that is
# normal. Working check:
#   curl -sS https://terraform-mirror.yandexcloud.net/registry.terraform.io/hashicorp/local/index.json
#
# Provider source addresses in *.tf stay "bpg/proxmox" / "hashicorp/local".
provider_installation {
  network_mirror {
    url     = "https://terraform-mirror.yandexcloud.net/"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
